<Project>
  <!--
    Central package management. Rules (docs/architecture/conventions.md#packages):
    * every PackageVersion here is used by at least one project (remove it when the last user goes);
    * no PackageReference to anything the shared framework already provides (NU1510 stays an error);
    * transitive pinning is on, so a pinned version also fixes a vulnerable transitive dependency.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <!-- PublicAPI.Shipped/Unshipped.txt per runtime package (D-6, docs/migration/release.md RL-5) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Roslyn (generators and generator tests)">
    <!-- The compiler of SDK 11.0.100 (Roslyn 5.12, results.md §8); a consumer's compiler must be at least this. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
  </ItemGroup>

  <ItemGroup Label="Messaging brokers (step 11D)">
    <!-- AOT-clean as used by Tarol.Messaging.Nats / .RabbitMq (published, 0 IL warnings; docs/migration/messaging.md §3.3). -->
    <PackageVersion Include="NATS.Net" Version="3.4.0" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.3.0" />
    <!-- the UI push's .NET client (the server side is the Microsoft.AspNetCore.App framework reference) -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Testcontainers.Nats" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.17.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <!-- FakeTimeProvider: the test clock Tarol recommends instead of an ambient clock (docs/architecture/time.md). -->
    <PackageVersion Include="Npgsql" Version="11.0.0" />
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks (tests/*/*.Benchmarks, never run in CI)">
    <!-- 0.15.x throws "GetRuntimeVersion not implemented" on net11.0; 0.16.0-preview.2 is the first that runs. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <!-- ASP.NET Core packages that are not part of the shared framework (step 10) -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
  </ItemGroup>
</Project>
