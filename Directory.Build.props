<Project>
  <!--
    Root build settings for every project in the repository.
    Layering: this file -> src/Directory.Build.props or tests/Directory.Build.props (each imports this one).
    Targets-side logic lives in Directory.Build.targets and eng/*.targets.
    See docs/architecture/conventions.md for the rationale of every setting.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- LangVersion is intentionally not set: C# 15 is the default for net11.0. Generators set it explicitly. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Deterministic>true</Deterministic>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>

    <!-- Project name == assembly name == root namespace == package id (Tarol.<Family>[.<Part>]). -->
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>

    <!-- Nothing is packable unless src/Directory.Build.props says so. -->
    <IsPackable>false</IsPackable>

    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Shared package metadata. Per-package Description and PackageTags are set in each csproj. -->
  <PropertyGroup>
    <Authors>Christoph Lorat</Authors>
    <Company>Christoph Lorat</Company>
    <Product>Tarol</Product>
    <Copyright>Copyright © 2026 Christoph Lorat</Copyright>
    <PackageProjectUrl>https://github.com/CLorat/Tarol-Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CLorat/Tarol-Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Proprietary, owner-only licence (docs/migration/plan.md D-1): the LICENSE file is packed into every package. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>
</Project>
