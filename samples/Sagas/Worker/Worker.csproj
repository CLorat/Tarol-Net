<Project Sdk="Microsoft.NET.Sdk">
  <!-- The ArtFlow reaction worker: Tarol.Sagas' hosted worker on the Npgsql store, the auction-list projection (Tarol.Queries.Npgsql), publishing to and consuming from billing (NATS or RabbitMQ), the nightly settlement report (Tarol.Jobs); traces to OTLP when a host sets it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ArtFlow.Worker</AssemblyName>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <ProjectReference Include="$(TarolRoot)src/Messaging/Tarol.Messaging.Nats/Tarol.Messaging.Nats.csproj" />
    <ProjectReference Include="$(TarolRoot)src/Messaging/Tarol.Messaging.RabbitMq/Tarol.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="$(TarolRoot)src/Messaging/Tarol.Messaging.Npgsql/Tarol.Messaging.Npgsql.csproj" />
    <ProjectReference Include="$(TarolRoot)src/Messaging/Tarol.Messaging.Generators/Tarol.Messaging.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(TarolRoot)src/Persistence/Tarol.Persistence.Npgsql/Tarol.Persistence.Npgsql.csproj" />
    <ProjectReference Include="$(TarolRoot)src/DataProtection/Tarol.DataProtection/Tarol.DataProtection.csproj" />
    <ProjectReference Include="$(TarolRoot)src/Jobs/Tarol.Jobs/Tarol.Jobs.csproj" />
    <ProjectReference Include="$(TarolRoot)src/Operations/Tarol.Operations/Tarol.Operations.csproj" />
    <ProjectReference Include="$(TarolRoot)src/Queries/Tarol.Queries.Npgsql/Tarol.Queries.Npgsql.csproj" />
    <ProjectReference Include="$(TarolRoot)src/Queries/Tarol.Queries.Generators/Tarol.Queries.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(TarolRoot)src/Changes/Tarol.Changes.Generators/Tarol.Changes.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(TarolRoot)src/Primitives/Tarol.Primitives.Generators/Tarol.Primitives.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(TarolRoot)src/Validations/Tarol.Validations.Generators/Tarol.Validations.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(TarolRoot)src/StronglyTypedId/Tarol.StronglyTypedId.Generators/Tarol.StronglyTypedId.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="../Shared/Broker.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
