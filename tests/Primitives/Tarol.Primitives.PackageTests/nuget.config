<?xml version="1.0" encoding="utf-8"?>
<!-- Package consumer test: Tarol.* comes ONLY from the locally packed artifacts, everything else from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="tarol-local" value="../../../artifacts/package/release" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="tarol-local">
      <package pattern="Tarol.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
