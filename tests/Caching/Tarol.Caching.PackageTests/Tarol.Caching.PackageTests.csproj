<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Consumer of the PACKED Tarol.Caching package (no ProjectReference). Proves that the package works over the in-memory
    read stores of its Tarol.Queries dependency, whose generator flows with it. Not part of Tarol.slnx: run by
    eng/verify-packages.sh, which passes TarolPackageVersion and an isolated packages folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TarolPackageVersion Condition="'$(TarolPackageVersion)' == ''">0.0.0-local</TarolPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tarol.Caching" VersionOverride="$(TarolPackageVersion)" />
  </ItemGroup>
</Project>
