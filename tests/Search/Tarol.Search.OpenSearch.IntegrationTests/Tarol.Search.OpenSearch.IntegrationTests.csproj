<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Integration tests of Tarol.Search.OpenSearch against OpenSearch 2.19.1 from Testcontainers (security plugin off, the disk
    threshold off: a shared CI volume may sit above OpenSearch's watermark): the contract suite every index passes, and the
    checkpoints in PostgreSQL. Needs Docker; every class carries [Trait("Category", "Integration")].
  -->
  <ItemGroup>
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Search/Tarol.Search.OpenSearch/Tarol.Search.OpenSearch.csproj" />
    <ProjectReference Include="../../../src/Search/Tarol.Search.Npgsql/Tarol.Search.Npgsql.csproj" />
    <ProjectReference Include="../../../src/Search/Tarol.Search.Generators/Tarol.Search.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Primitives/Tarol.Primitives.Generators/Tarol.Primitives.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/StronglyTypedId/Tarol.StronglyTypedId.Generators/Tarol.StronglyTypedId.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Kernel/Tarol.Kernel.Generators/Tarol.Kernel.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Results/Tarol.Results.Generators/Tarol.Results.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Options/Tarol.Options.Generators/Tarol.Options.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
