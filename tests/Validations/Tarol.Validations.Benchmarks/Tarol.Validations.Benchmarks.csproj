<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BenchmarkDotNet measurements of generated value objects and input validation. Built with the solution, never run in
    CI. Run:
      dotnet run -c Release -project tests/Validations/Tarol.Validations.Benchmarks - -filter '*'
    (double the dashes). The comparison with Microsoft.Extensions.Validation and DataAnnotations is the probe
    docs/migration/probes/validations/bench (docs/migration/validations.md §3.3).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Validations/Tarol.Validations/Tarol.Validations.csproj" />
    <ProjectReference Include="../../../src/Validations/Tarol.Validations.Generators/Tarol.Validations.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
</Project>
