<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Integration tests of Tarol.Operations against PostgreSQL 17 from Testcontainers (D-15): the snapshot over a populated store,
    the admin entry's audited acts and tarol.purge-dead. Needs Docker; every class carries [Trait("Category", "Integration")].
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <ProjectReference Include="../../../src/Operations/Tarol.Operations/Tarol.Operations.csproj" />
    <ProjectReference Include="../../../src/Persistence/Tarol.Persistence.Npgsql/Tarol.Persistence.Npgsql.csproj" />
    <ProjectReference Include="../../../src/Primitives/Tarol.Primitives.Generators/Tarol.Primitives.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Kernel/Tarol.Kernel.Generators/Tarol.Kernel.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Results/Tarol.Results.Generators/Tarol.Results.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Options/Tarol.Options.Generators/Tarol.Options.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- the contract models of the store's tests (Member, ContractJson) -->
    <Compile Include="../../Persistence/Shared/ContractModels.cs" LinkBase="Contract" />
  </ItemGroup>
</Project>
