<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Consumer of the PACKED Tarol.Operations package (no ProjectReference): AddOperations over the in-memory store of its
    Tarol.Persistence dependency, a poll and the health groups. Not part of Tarol.slnx: run by eng/verify-packages.sh, which
    passes TarolPackageVersion and an isolated packages folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TarolPackageVersion Condition="'$(TarolPackageVersion)' == ''">0.0.0-local</TarolPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Tarol.Operations" VersionOverride="$(TarolPackageVersion)" />
  </ItemGroup>
</Project>
