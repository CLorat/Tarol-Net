<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Consumer of the PACKED Tarol.Messaging.Npgsql package (no ProjectReference): the bus and the dead letters register and
    resolve, the scripts are there, and the Messaging generator flows from the dependency.
    Not part of Tarol.slnx: run by eng/verify-packages.sh, which passes TarolPackageVersion and an isolated packages folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TarolPackageVersion Condition="'$(TarolPackageVersion)' == ''">0.0.0-local</TarolPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tarol.Messaging.Npgsql" VersionOverride="$(TarolPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
