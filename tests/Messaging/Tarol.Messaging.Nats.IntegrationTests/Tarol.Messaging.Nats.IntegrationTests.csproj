<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Integration tests of Tarol.Messaging.Nats against a real broker from Testcontainers (D-15): the shared
    transport contract (tests/Messaging/Shared) on a bus schema per test, plus the bus's own rows (roles, row-level
    security, NOTIFY, leases, dead letters, retention, the hosted round trip). Needs Docker; every class carries
    [Trait("Category", "Integration")].
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Testcontainers.Nats" />
    <ProjectReference Include="../../../src/Messaging/Tarol.Messaging.Nats/Tarol.Messaging.Nats.csproj" />
    <ProjectReference Include="../../../src/Messaging/Tarol.Messaging.Generators/Tarol.Messaging.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Changes/Tarol.Changes.Generators/Tarol.Changes.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Primitives/Tarol.Primitives.Generators/Tarol.Primitives.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Validations/Tarol.Validations.Generators/Tarol.Validations.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/StronglyTypedId/Tarol.StronglyTypedId.Generators/Tarol.StronglyTypedId.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Kernel/Tarol.Kernel.Generators/Tarol.Kernel.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Results/Tarol.Results.Generators/Tarol.Results.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="../Shared/**/*.cs" LinkBase="Contract" />
  </ItemGroup>
</Project>
