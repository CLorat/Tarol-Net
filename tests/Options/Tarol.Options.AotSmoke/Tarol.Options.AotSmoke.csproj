<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Native-AOT smoke test of Tarol.Options. Publish with
      dotnet publish tests/Options/Tarol.Options.AotSmoke -c Release -r linux-x64
    It must report 0 IL2xxx/IL3xxx warnings and exit 0 (eng/aot-smoke.sh does both).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Every JSON call must go through generated metadata. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Options/Tarol.Options/Tarol.Options.csproj" />
    <ProjectReference Include="../../../src/Options/Tarol.Options.Generators/Tarol.Options.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
