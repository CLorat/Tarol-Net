<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Event-sourced aggregates with child entities and short user code: behaviour methods decide and raise pure-payload events, On handlers apply them live and on replay through one generated dispatch, child entities route, cascade and stay closed to bypasses, invariants run when the events are handed to the store, analyzers keep decisions out of apply. Native-AOT ready.</Description>
    <PackageTags>tarol;ddd;event-sourcing;aggregate;cqrs;source-generator;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Kernel/Tarol.Kernel/Tarol.Kernel.csproj" />
    <ProjectReference Include="../../Results/Tarol.Results/Tarol.Results.csproj" />
    <ProjectReference Include="../../Options/Tarol.Options/Tarol.Options.csproj" />
    <ProjectReference Include="../../StronglyTypedId/Tarol.StronglyTypedId/Tarol.StronglyTypedId.csproj" />
    <!-- D-10: the aggregate generator and the domain analyzers (TPRM001-TPRM015) ship inside this package. -->
    <ProjectReference Include="../Tarol.Primitives.Generators/Tarol.Primitives.Generators.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" TarolGenerator="true" />
    <!-- The Options, Results and Kernel analyzers on this package's own code (analyzer references do not flow; kernel.md §8). -->
    <ProjectReference Include="../../Options/Tarol.Options.Generators/Tarol.Options.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Results/Tarol.Results.Generators/Tarol.Results.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Kernel/Tarol.Kernel.Generators/Tarol.Kernel.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>
</Project>
