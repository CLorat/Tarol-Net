<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Authorization of Tarol changes with ASP.NET Core: the change is the requirement, the loaded (or new) aggregate the resource; the app's roles are mapped onto the changes and reads they may run, row rules on the aggregate grant or deny (deny wins), nothing granted is denied; denials are logged and counted. Checked only for runs that carry a principal (HTTP), not for jobs and reactions. Works without a web host. Native-AOT ready.</Description>
    <PackageTags>tarol;ddd;authorization;roles;resource-based;multi-tenancy;aspnetcore;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.Authorization is part of the ASP.NET Core shared framework (never a package, AGENTS.md). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Changes/Tarol.Changes/Tarol.Changes.csproj" />
    <ProjectReference Include="../../Options/Tarol.Options.Generators/Tarol.Options.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Results/Tarol.Results.Generators/Tarol.Results.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Kernel/Tarol.Kernel.Generators/Tarol.Kernel.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>
</Project>
