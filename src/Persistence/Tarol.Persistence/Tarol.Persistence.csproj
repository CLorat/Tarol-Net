<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The aggregate store port of Tarol: tenant-scoped loads, appends with an expected version and an idempotency key stored in the same commit, unique lookups, and an in-memory store for tests that records every event with its operation context and exercises the stored state. Native-AOT ready.</Description>
    <PackageTags>tarol;ddd;event-sourcing;event-store;idempotency;multi-tenancy;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Primitives/Tarol.Primitives/Tarol.Primitives.csproj" />
    <!-- The Options, Results and Kernel analyzers on this package's own code (analyzer references do not flow; kernel.md §8). -->
    <ProjectReference Include="../../Options/Tarol.Options.Generators/Tarol.Options.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Results/Tarol.Results.Generators/Tarol.Results.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Kernel/Tarol.Kernel.Generators/Tarol.Kernel.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>
</Project>
