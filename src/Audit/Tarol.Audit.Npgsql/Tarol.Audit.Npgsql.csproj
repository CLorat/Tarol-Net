<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>PostgreSQL store of Tarol.Audit, in the event store's database: one row per event and field (before and after, personal values sealed) and the last value per field in tables per projection version, written with the checkpoint in one transaction; reads and denials in their own table; keyset paging newest first by tenant, target and actor. Native-AOT ready.</Description>
    <PackageTags>tarol;ddd;event-sourcing;audit;change-log;postgresql;npgsql;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tarol.Audit/Tarol.Audit.csproj" />
    <ProjectReference Include="../../Queries/Tarol.Queries.Npgsql/Tarol.Queries.Npgsql.csproj" />
    <!-- The Options, Results and Kernel analyzers on this package's own code (analyzer references do not flow; kernel.md §8). -->
    <ProjectReference Include="../../Options/Tarol.Options.Generators/Tarol.Options.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Results/Tarol.Results.Generators/Tarol.Results.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Kernel/Tarol.Kernel.Generators/Tarol.Kernel.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <InternalsVisibleTo Include="$(AssemblyName).IntegrationTests" />
  </ItemGroup>
</Project>
