<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>PostgreSQL read tables for Tarol projections on plain Npgsql: a table per projection version (rm_name_vN) with typed columns from the generated column map plus the row as jsonb, the tenant first in every key and index, an index per sort, the checkpoint in a projections table moved first and guarded in the same transaction as the rows, the building/current state of a rebuild, list queries over the columns, SQL projections in the batch transaction, and the LISTEN wake-up on the store's feed NOTIFY. Native-AOT ready.</Description>
    <PackageTags>tarol;ddd;event-sourcing;cqrs;projection;read-model;postgresql;npgsql;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tarol.Queries/Tarol.Queries.csproj" />
    <ProjectReference Include="../../Persistence/Tarol.Persistence.Npgsql/Tarol.Persistence.Npgsql.csproj" />
    <!-- The Options, Results and Kernel analyzers on this package's own code (analyzer references do not flow; kernel.md §8). -->
    <ProjectReference Include="../../Options/Tarol.Options.Generators/Tarol.Options.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Results/Tarol.Results.Generators/Tarol.Results.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Kernel/Tarol.Kernel.Generators/Tarol.Kernel.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <InternalsVisibleTo Include="Tarol.Queries.Npgsql.IntegrationTests" />
  </ItemGroup>
</Project>
