<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>NATS JetStream transport of Tarol.Messaging: one stream per source system with a duplicate window, Nats-Msg-Id per event, contract and version (a duplicate publish is a success), one durable pull consumer per subscription with AckWait as the lease and MaxAckPending as the concurrency, delayed retries with Nak, subject permissions per user decide who may publish under a prefix. Native-AOT ready.</Description>
    <PackageTags>tarol;ddd;event-sourcing;messaging;nats;jetstream;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NATS.Net" />
    <ProjectReference Include="../Tarol.Messaging/Tarol.Messaging.csproj" />
    <ProjectReference Include="../../Options/Tarol.Options.Generators/Tarol.Options.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Results/Tarol.Results.Generators/Tarol.Results.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../Kernel/Tarol.Kernel.Generators/Tarol.Kernel.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
</Project>
